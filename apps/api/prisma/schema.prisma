generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN        // Administrador global
  COORDINADOR
  PERSONERO
}

enum Cargo {
  GOBERNADOR_REGIONAL
  CONSEJERO_REGIONAL
  ALCALDE_PROVINCIAL
  ALCALDE_DISTRITAL
}

// No existe un estado "pendiente": mientras no se guarde un Acta para un
// (mesa, cargo), simplemente no hay fila — eso ES "sin registrar".
enum EstadoActa {
  ENVIADA
  VALIDADA
  OBSERVADA
}

enum TipoResultado {
  VOTO_LISTA
  BLANCO
  NULO
  IMPUGNADO
}

model Usuario {
  id            String     @id @default(uuid())
  nombre        String
  dni           String     @unique
  email         String?    @unique
  telefono      String?
  passwordHash  String
  rol           RolUsuario
  activo        Boolean    @default(true)
  createdAt     DateTime   @default(now())

  // Un personero depende de un coordinador (jerarquía a un solo nivel).
  coordinadorId String?
  coordinador   Usuario?   @relation("Jerarquia", fields: [coordinadorId], references: [id])
  personeros    Usuario[]  @relation("Jerarquia")

  actas         Acta[]
  mesasAsignadas Mesa[]
}

model Provincia {
  id        String     @id @default(uuid())
  nombre    String     @unique
  distritos Distrito[]
}

model Distrito {
  id                 String    @id @default(uuid())
  nombre             String
  capitalDeProvincia Boolean   @default(false)
  provinciaId        String
  provincia          Provincia @relation(fields: [provinciaId], references: [id])
  localesVotacion    LocalVotacion[]

  @@unique([provinciaId, nombre])
}

model LocalVotacion {
  id          String   @id @default(uuid())
  codigo      String   @unique
  nombre      String
  direccion   String?
  distritoId  String
  distrito    Distrito @relation(fields: [distritoId], references: [id])
  mesas       Mesa[]
}

model Mesa {
  id                     String        @id @default(uuid())
  codigo                 String        @unique
  aula                   String?
  piso                   String?
  pabellon               String?
  electores              Int           @default(0)
  electoresDiscapacidad  Int           @default(0)
  localVotacionId        String
  localVotacion          LocalVotacion @relation(fields: [localVotacionId], references: [id])
  personeroId            String?
  personero              Usuario?      @relation(fields: [personeroId], references: [id])
  actas                  Acta[]
}

model OrganizacionPolitica {
  id         String   @id @default(uuid())
  nombre     String   @unique
  simboloUrl String?
  listas     ListaCandidatura[]
}

// Una lista de candidatura representa a una organización política compitiendo
// por un cargo, en un alcance geográfico específico (región, provincia o distrito).
model ListaCandidatura {
  id              String     @id @default(uuid())
  cargo           Cargo
  organizacionId  String
  organizacion    OrganizacionPolitica @relation(fields: [organizacionId], references: [id])
  // Alcance: cadena vacía "" significa "no aplica" para ese nivel. Se usan valores
  // no nulos (en vez de NULL) porque una clave única compuesta con columnas NULL
  // no se comporta como esperamos en Postgres/Prisma (NULL nunca es igual a NULL).
  // GOBERNADOR_REGIONAL -> ambos "" (alcance regional completo)
  // CONSEJERO_REGIONAL / ALCALDE_PROVINCIAL -> provinciaNombre, distritoNombre=""
  // ALCALDE_DISTRITAL -> provinciaNombre + distritoNombre
  provinciaNombre String @default("")
  distritoNombre  String @default("")
  orden           Int
  expediente      String?
  jee             String?
  resultados      ActaResultado[]

  @@unique([cargo, provinciaNombre, distritoNombre, organizacionId])
}

// Una Acta cubre UN cargo de UNA mesa (así se cuenta y se revisa en la
// práctica: el personero llena Gobernador, Consejero, Alcalde provincial y
// -si aplica- Alcalde distrital como actas independientes de la misma mesa).
model Acta {
  id             String     @id @default(uuid())
  clienteId      String     @unique // id generado offline en el dispositivo, para idempotencia de sync
  mesaId         String
  mesa           Mesa       @relation(fields: [mesaId], references: [id])
  cargo          Cargo
  personeroId    String
  personero      Usuario    @relation(fields: [personeroId], references: [id])
  estado         EstadoActa @default(ENVIADA)
  observaciones  String?
  fotoBase64     String?    @db.Text // foto del acta física, comprimida en el dispositivo antes de enviarse
  digitadaEn     DateTime
  sincronizadaEn DateTime   @default(now())
  resultados     ActaResultado[]

  @@unique([mesaId, cargo])
}

model ActaResultado {
  id                 String            @id @default(uuid())
  actaId             String
  acta               Acta              @relation(fields: [actaId], references: [id], onDelete: Cascade)
  listaCandidaturaId String?
  listaCandidatura   ListaCandidatura? @relation(fields: [listaCandidaturaId], references: [id])
  tipo               TipoResultado
  votos              Int

  @@index([actaId])
}
