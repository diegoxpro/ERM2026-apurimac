# Este archivo es para docker-compose (raíz del proyecto). Para desarrollo
# local sin Docker, usa apps/api/.env y apps/web/.env por separado (ver README).

JWT_SECRET="genera_un_secreto_largo_y_aleatorio_aqui"
CORS_ORIGIN="https://tu-dominio.example"

# Puerto del host donde queda expuesto el frontend (nginx enruta /api y
# /socket.io internamente hacia el backend, así que solo se publica este).
WEB_PORT=1158

# Puerto del host donde queda expuesta la PWA de personeros (mismo backend,
# distinto dominio/puerto: personero.aricast.lat -> este puerto).
PERSONERO_PORT=1159

# Vacío = el frontend llama a la API por el mismo origen/dominio (recomendado
# en producción, vía el proxy de nginx). Solo se usa distinto en desarrollo.
VITE_API_URL=

POSTGRES_USER=erm2026
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=erm2026

# Token de la API de consulta de DNI (https://api.migo.pe) usado para
# autocompletar el nombre al crear un usuario. Opcional: si falta, esa
# función simplemente queda deshabilitada (el admin escribe el nombre a mano).
DNI_API_TOKEN=

# Vuelta electoral con la que opera el sistema: PRIMERA o SEGUNDA.
# En SEGUNDA, la cédula solo tiene Gobernador y Vicegobernador Regional con las
# 2 fórmulas cargadas por `npm run seed:segunda-vuelta` (ver README). Cambiarla
# solo requiere `docker compose up -d api`; los datos de primera vuelta se conservan.
VUELTA_ACTIVA=PRIMERA
